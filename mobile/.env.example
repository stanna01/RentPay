# Copy to .env.local (never commit it) to change how the app runs.

# demo (default): sample data inside the app, no server needed.
# live: talk to the RentReceipt server below (needs the /api/v1 endpoints from
#       docs/PLATFORM_PLAN.md, which are built in roadmap phases 1-5).
EXPO_PUBLIC_API_MODE=demo

# Base URL of the server in live mode (https in production).
EXPO_PUBLIC_API_URL=https://rent.yourdomain.com
