# Copy to .env.local (never commit it) to change how the app runs.

# demo (default): sample data inside the app, no server needed.
# live: talk to the RentReceipt server below. Landlords only for now: sign-in
#       and the dashboard are real; student and sponsor screens are not built
#       on the server yet (docs/PLATFORM_PLAN.md, roadmap phases 2-5).
EXPO_PUBLIC_API_MODE=demo

# Base URL of the server in live mode (https in production). When testing on
# a phone against your own computer, use the computer's Wi-Fi address, e.g.
# http://192.168.1.20:4000 (not "localhost", which is the phone itself).
EXPO_PUBLIC_API_URL=https://rent.yourdomain.com
