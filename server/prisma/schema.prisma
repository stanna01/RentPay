// RentReceipt — data model
// All money is stored as INTEGER ngwee (1 Kwacha = 100 ngwee) to avoid floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A landlord business. Everything a landlord owns (properties, rooms, tenants,
/// payments, receipts) hangs off its properties, and no landlord can see
/// another's data. Created and suspended by the super admin.
model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true) // false = suspended: its users cannot sign in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  properties Property[]
}

/// A person who can log in. SUPER_ADMIN runs the platform (creates and
/// suspends landlords, global settings, full audit log) and belongs to no
/// organization. LANDLORD runs one landlord business: everything inside their
/// own organization and nothing outside it.
model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  name               String    @default("")
  role               String    @default("LANDLORD") // SUPER_ADMIN | LANDLORD
  organizationId     Int? // null for SUPER_ADMIN
  passwordHash       String
  isActive           Boolean   @default(true)
  // Bumped to revoke every existing session (password change, reset, role
  // change, deactivation, "log out everywhere").
  tokenVersion       Int       @default(0)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  auditLogs    AuditLog[]

  @@index([organizationId])
}

/// Platform-wide settings (super admin): email/SMTP config used for all landlords.
model Setting {
  id            Int      @id @default(1)
  landlordEmail String   @default("") // contact/test address
  // SMTP overrides (fall back to .env when blank). Password stored server-side only.
  smtpHost      String   @default("")
  smtpPort      Int      @default(465)
  smtpSecure    Boolean  @default(true)
  smtpUser      String   @default("")
  smtpPass      String   @default("")
  smtpFromName  String   @default("RentReceipt")
  smtpFromEmail String   @default("")
  updatedAt     DateTime @updatedAt
}

/// A rental property. Its name/address are printed on receipts and its short
/// code is part of every receipt number issued for it.
model Property {
  id             Int       @id @default(autoincrement())
  organizationId Int
  name           String
  address        String    @default("")
  // e.g. "KC" → RCT-KC-2026-0001. Unique across the whole platform, because
  // receipt numbers must never collide between landlords.
  code           String    @unique
  // How rent is billed: MONTHLY (on the 1st, due on dueDay) or TERM (once per
  // BillingTerm the landlord enters). Can only change before any rent is billed.
  billingCycle   String    @default("MONTHLY")
  dueDay         Int       @default(5) // MONTHLY: day of the month rent is due
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rooms           Room[]
  tenants         Tenant[]
  receiptCounters ReceiptCounter[]
  terms           BillingTerm[]
  notices         Notice[]
  rentIncreases   RentIncrease[]

  @@index([organizationId])
}

/// A physical room. Occupancy is derived from the current tenancy per bed.
model Room {
  id          Int       @id @default(autoincrement())
  propertyId  Int
  number      Int
  bedCount    Int       @default(2) // beds are labelled A, B, C…
  defaultRent Int       @default(0) // ngwee
  archivedAt  DateTime?

  property  Property  @relation(fields: [propertyId], references: [id])
  tenancies Tenancy[]

  @@unique([propertyId, number])
}

model Tenant {
  id         Int       @id @default(autoincrement())
  propertyId Int
  name       String
  phone      String    @default("")
  email      String    @default("")
  notes      String    @default("")
  deletedAt  DateTime? // soft delete (records are kept)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  property  Property          @relation(fields: [propertyId], references: [id])
  tenancies Tenancy[]
  notices   NoticeRecipient[]

  @@index([propertyId])
}

/// A tenant's stay in a specific bed of a room. moveOutDate == null means current.
model Tenancy {
  id           Int       @id @default(autoincrement())
  roomId       Int
  bed          String    @default("A")
  tenantId     Int
  moveInDate   DateTime
  moveOutDate  DateTime?
  archivedAt   DateTime? // set when a moved-out tenancy is archived (hidden from lists)
  // ngwee per month or per term (the property's billingCycle). Copied from the
  // room's default rent at move-in. Later changes are RentChange rows.
  rent         Int
  // "roomId-bed" while current, NULL after move-out. The unique index makes it
  // impossible for two current tenancies to occupy the same bed.
  activeBedKey String?   @unique
  createdAt    DateTime  @default(now())

  room        Room         @relation(fields: [roomId], references: [id])
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  payments    Payment[]
  charges     Charge[]
  rentChanges RentChange[]

  @@index([roomId, bed])
  @@index([tenantId])
}

model Payment {
  id                Int       @id @default(autoincrement())
  tenancyId         Int
  amount            Int // ngwee
  datePaid          DateTime  @default(now())
  method            String    @default("cash") // cash | mobile_money | bank
  status            String    @default("ACTIVE") // ACTIVE | VOID
  voidedAt          DateTime?
  voidedById        Int?
  voidReason        String    @default("")
  replacesPaymentId Int? // set on a correction: the voided payment it replaces
  createdById       Int?
  createdAt         DateTime  @default(now())

  tenancy      Tenancy @relation(fields: [tenancyId], references: [id])
  // What the receipt says, frozen when the payment is recorded:
  // [{ chargeId, description, chargeAmount, paid, balanceAfter }]
  receiptLines Json?
  creditAfter  Int     @default(0) // ngwee held as credit right after this payment
  balanceAfter Int     @default(0) // ngwee the tenant still owed right after it

  allocations Allocation[]
  receipt     Receipt?

  @@index([tenancyId])
  @@index([status])
}

model Receipt {
  id            Int       @id @default(autoincrement())
  paymentId     Int       @unique
  receiptNumber String    @unique // RCT-CODE-YYYY-NNNN (legacy: RCT-YYYY-NNNN)
  pdf           Bytes?    @db.LongBlob // the immutable receipt PDF, stored in the DB
  voidPdf       Bytes?    @db.LongBlob // copy stamped VOID, created when the payment is voided
  emailedAt     DateTime?
  emailStatus   String    @default("none") // none | pending | sent | failed
  createdAt     DateTime  @default(now())

  payment    Payment      @relation(fields: [paymentId], references: [id])
  emailQueue EmailQueue[]
}

/// Atomic sequential receipt numbering, per property per year.
model ReceiptCounter {
  propertyId Int
  year       Int
  lastSeq    Int @default(0)

  property Property @relation(fields: [propertyId], references: [id])

  @@id([propertyId, year])
}

/// A term the landlord bills for (TERM properties), e.g. "Semester 1 2027".
model BillingTerm {
  id         Int      @id @default(autoincrement())
  propertyId Int
  name       String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  dueDate    DateTime @db.Date
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  charges  Charge[]

  @@index([propertyId, startDate])
}

/// One line on a tenant's bill. Rent charges are created automatically once
/// per month or term; deposits and fees are added by the landlord. Never
/// deleted: a wrong charge is cancelled with a reason.
model Charge {
  id            Int       @id @default(autoincrement())
  tenancyId     Int
  type          String // RENT | DEPOSIT | FEE | OTHER
  description   String
  amount        Int // ngwee, never changes after creation
  dueDate       DateTime  @db.Date
  periodStart   DateTime? @db.Date // RENT: first day of the month / term
  // RENT: "M-2027-01" or "T-<termId>" while live, NULL once cancelled. The
  // unique index makes it impossible to bill the same month or term twice.
  periodKey     String?
  termId        Int?
  createdById   Int? // null = created automatically
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String    @default("")
  createdAt     DateTime  @default(now())

  tenancy     Tenancy      @relation(fields: [tenancyId], references: [id])
  term        BillingTerm? @relation(fields: [termId], references: [id])
  allocations Allocation[]
  waivers     Waiver[]

  @@unique([tenancyId, periodKey])
  @@index([tenancyId, dueDate])
}

/// How much of a payment went to which charge. Counts only while the payment
/// is ACTIVE and the charge is not cancelled; otherwise the money is credit.
model Allocation {
  id        Int      @id @default(autoincrement())
  paymentId Int
  chargeId  Int
  amount    Int // ngwee
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
  charge  Charge  @relation(fields: [chargeId], references: [id])

  @@index([paymentId])
  @@index([chargeId])
}

/// Part of a charge the landlord lets off, with a reason. Reversed, never deleted.
model Waiver {
  id           Int       @id @default(autoincrement())
  chargeId     Int
  amount       Int // ngwee, > 0
  reason       String
  createdById  Int
  reversedAt   DateTime?
  reversedById Int?
  createdAt    DateTime  @default(now())

  charge Charge @relation(fields: [chargeId], references: [id])

  @@index([chargeId])
}

/// A rent increase announced to tenants with at least 30 days' notice, for a
/// whole property (roomIds null) or chosen rooms. On startsOn the rooms'
/// default rent changes too.
model RentIncrease {
  id          Int       @id @default(autoincrement())
  propertyId  Int
  roomIds     Json? // null = every room of the property
  newRent     Int // ngwee per month or per term
  startsOn    DateTime  @db.Date
  noticeId    Int?
  createdById Int
  appliedAt   DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  property Property     @relation(fields: [propertyId], references: [id])
  changes  RentChange[]

  @@index([propertyId])
}

/// A change to one tenancy's rent from a date. Rent charges for periods that
/// start on or after startsOn use newRent; charges already issued never change.
model RentChange {
  id             Int       @id @default(autoincrement())
  tenancyId      Int
  rentIncreaseId Int?
  oldRent        Int
  newRent        Int
  startsOn       DateTime  @db.Date
  createdById    Int
  appliedAt      DateTime? // when tenancy.rent was set to newRent
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())

  tenancy      Tenancy       @relation(fields: [tenancyId], references: [id])
  rentIncrease RentIncrease? @relation(fields: [rentIncreaseId], references: [id])

  @@index([tenancyId, startsOn])
}

/// A message sent to tenants (by email for now): a general notice, or the
/// notice of a rent increase / its cancellation. Never edited after sending.
model Notice {
  id          Int      @id @default(autoincrement())
  propertyId  Int
  kind        String // MESSAGE | RENT_INCREASE | RENT_INCREASE_CANCELLED
  subject     String
  message     String   @db.Text
  createdById Int
  createdAt   DateTime @default(now())

  property   Property          @relation(fields: [propertyId], references: [id])
  recipients NoticeRecipient[]

  @@index([propertyId, createdAt])
}

/// One tenant a notice went to, with the exact text they were sent.
model NoticeRecipient {
  id        Int       @id @default(autoincrement())
  noticeId  Int
  tenantId  Int
  email     String    @default("") // "" = no email on file: tell them in person
  message   String    @db.Text
  status    String    @default("pending") // pending | sent | failed | no_email
  sentAt    DateTime?
  lastError String    @default("")

  notice     Notice       @relation(fields: [noticeId], references: [id])
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  emailQueue EmailQueue[]

  @@index([noticeId])
}

/// Outbox for receipt and notice emails; retried by a background worker.
model EmailQueue {
  id                Int       @id @default(autoincrement())
  receiptId         Int?
  noticeRecipientId Int?
  status            String    @default("pending") // pending | sent | failed
  attempts          Int       @default(0)
  lastError         String    @default("")
  nextRetryAt       DateTime  @default(now())
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  receipt         Receipt?         @relation(fields: [receiptId], references: [id])
  noticeRecipient NoticeRecipient? @relation(fields: [noticeRecipientId], references: [id])

  @@index([status, nextRetryAt])
}

/// Per-email failed-login tracking (kept for unknown emails too, so lockout
/// behaviour never reveals whether an account exists).
model LoginThrottle {
  email        String    @id
  failedCount  Int       @default(0)
  lockoutLevel Int       @default(0)
  lockedUntil  DateTime?
  lastFailedAt DateTime?
}

/// Append-only record of who did what. There is no API to edit or delete it.
/// organizationId is the landlord business the action belongs to (null for
/// platform actions), so each landlord can read their own log.
model AuditLog {
  id             Int      @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  action         String
  entityType     String   @default("")
  entityId       String   @default("")
  before         Json?
  after          Json?
  ip             String   @default("")
  userAgent      String   @default("") @db.VarChar(255)
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([organizationId, id])
}
