{
  "name": "rentreceipt",
  "version": "1.0.0",
  "private": true,
  "description": "RentReceipt — rent tracking and receipt PWA for a single 24-room property in Zambia",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate --workspace server",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "set-password": "npm run set-password --workspace server --",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
