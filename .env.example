# ---------------------------------------------------------------------------
# RentReceipt environment configuration
# Copy this file to server/.env  (cp .env.example server/.env) and fill it in.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Port the backend listens on. In production this same server also serves the
# built React app.
PORT=4000

# "development" or "production"
NODE_ENV=development

# --- Database -------------------------------------------------------------
# MySQL 8 connection string. Use a managed MySQL (Railway, Aiven, etc.).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Railway: copy the MYSQL_PUBLIC_URL from the MySQL service's Variables tab.
DATABASE_URL="mysql://user:password@host:3306/railway"

# Optional: set SEED_DEMO=1 when seeding to add sample tenants/payments for
# local testing. Leave unset for a clean production database (landlord + rooms).
# SEED_DEMO=1

# --- Auth -----------------------------------------------------------------
# Secret used to sign login cookies AND to encrypt the stored SMTP password.
# MUST be a long, random, unique string. The server REFUSES TO START in
# production if this is missing, too short (< 32 chars), or looks like a
# placeholder. Generate a strong one with:
#   openssl rand -base64 48
# Note: changing this later logs everyone out and requires re-entering the SMTP
# password in Settings (it is encrypted with a key derived from this secret).
JWT_SECRET="change-me-to-a-long-random-string"

# How long a login stays valid.
JWT_EXPIRES_IN="30d"

# Public URL of the app, used to build password-reset links in emails.
# In development the app infers this from the browser; set it in production,
# e.g. APP_URL="https://rent.yourdomain.com"
APP_URL=""

# The single landlord account. The seed script creates this account.
# Change the password after first login from the Settings screen.
LANDLORD_EMAIL="landlord@example.com"
LANDLORD_PASSWORD="changeme123"

# --- Email (SMTP) ---------------------------------------------------------
# These provide DEFAULTS. They can also be set/overridden at runtime from the
# in-app Settings screen (stored in the database). See docs/EMAIL_SETUP.md.
#
# Gmail example (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=your-resend-api-key
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Display name + address that receipts are sent "from".
SMTP_FROM_NAME="RentReceipt"
SMTP_FROM_EMAIL=
