# ---------------------------------------------------------------------------
# RentReceipt environment configuration
# Copy this file to server/.env  (cp .env.example server/.env) and fill it in.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Port the backend listens on. In production this same server also serves the
# built React app.
PORT=4000

# "development" or "production"
NODE_ENV=development

# --- Database -------------------------------------------------------------
# MySQL 8 connection string. Use a managed MySQL (Railway, Aiven, etc.).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Railway: copy the MYSQL_PUBLIC_URL from the MySQL service's Variables tab.
DATABASE_URL="mysql://user:password@host:3306/railway"

# Optional: set SEED_DEMO=1 when seeding to add sample tenants/payments for
# local testing. Leave unset for a clean production database (admin + property + rooms).
# SEED_DEMO=1

# --- Security -------------------------------------------------------------
# The server REFUSES TO START in production if any of these is missing, short
# (< 32 chars) or looks like a placeholder. Generate each one separately with:
#   openssl rand -base64 48

# Signs login cookies. Changing it signs everyone out.
JWT_SECRET="change-me-to-a-long-random-string"

# Encrypts secrets stored in the database (the SMTP password). Must be
# DIFFERENT from JWT_SECRET. Values saved before this existed are re-encrypted
# automatically at startup. Changing it later means re-entering the SMTP
# password in Settings.
ENCRYPTION_KEY="change-me-to-a-different-long-random-string"

# Public URL of the app (https:// in production). Password-reset links are
# built ONLY from this value — never from request headers — and it is the
# only origin allowed to make changes (CSRF protection). Required in production.
# Leave blank in development (defaults to http://localhost:5173).
APP_URL=""

# Timezone for month boundaries in the dashboard, reports and receipts.
# Defaults to Africa/Lusaka when unset.
# TZ="Africa/Lusaka"

# Sessions end after 12 hours without activity and always after 7 days.

# --- First administrator ------------------------------------------------------
# The seed script creates this admin account with a TEMPORARY password that
# must be changed at first sign-in (at least 12 characters, not a common one).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="a-temporary-passphrase-for-first-sign-in"

# --- Email (SMTP) ---------------------------------------------------------
# These provide DEFAULTS. They can also be set/overridden at runtime from the
# in-app Settings screen (stored in the database). See docs/EMAIL_SETUP.md.
#
# Gmail example (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=your-resend-api-key
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Display name + address that receipts are sent "from".
SMTP_FROM_NAME="RentReceipt"
SMTP_FROM_EMAIL=

# --- Tests ------------------------------------------------------------------
# Database tests WRITE data. They only run when TEST_DATABASE=1, and
# DATABASE_URL must then point at a throwaway, migrated database — never prod.
# TEST_DATABASE=1
